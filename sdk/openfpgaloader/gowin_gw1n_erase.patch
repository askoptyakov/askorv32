+/* Erase embedded flash only (GW1N, --bulk-erase without --external-flash):
+ * same sequence as programFlash() without writing, then reload
+ */
+bool Gowin::eraseEmbeddedFlash()
+{
+	_jtag->setClkFreq(2500000);
+
+	send_command(CONFIG_DISABLE);
+	send_command(0);
+	_jtag->set_state(Jtag::TEST_LOGIC_RESET);
+	uint32_t state = readStatusReg();
+	if ((state & (STATUS_GOWIN_VLD | STATUS_POR)) == 0) {
+		displayReadReg("Either GOWIN_VLD or POR should be set, aborting", state);
+		return false;
+	}
+
+	if (!eraseSRAM())
+		return false;
+	if (!enableCfg())
+		return false;
+	if (!eraseFLASH())
+		return false;
+	if (!disableCfg())
+		return false;
+	reset();
+	return true;
+}
