{
  "format": "askorv32-gwsoc",
  "version": 2,
  "board": { "id": "tangnano9k", "title": "Tang Nano 9K", "buildConfig": "TangNano9K", "loader": "tangnano9k" },
  "device": "GW1NR-LV9QN88PC6/I5",
  "paths": {
    "hw": "../../../hw/boards/tangnano9k",
    "src": "../../../hw/src",
    "top": "top.sv",
    "cst": "riscv.cst",
    "soc": "soc.h",
    "generator": "../../../sw/socgen/socgen.py"
  },
  "core": {
    "coreType": "pipeline",
    "mExt": true,
    "divBpc": 2,
    "debug": true,
    "plicSources": 8,
    "imem": { "type": "bsram", "kb": 16, "synthWords": 256, "init": "mem_init/i.mem" },
    "dmem": { "type": "bsram", "kb": 8, "synthWords": 256, "init": "mem_init/d.mem" }
  },
  "clock": {
    "xtalMHz": 27,
    "xtalPin": 52,
    "pll": { "mode": "auto", "targetMHz": 40.5, "idiv": 2, "fbdiv": 4, "odiv": 16 }
  },
  "reset": { "pin": 3 },
  "periph": [
    { "type": "gpio", "name": "GPIO", "base": "auto", "lines": [75, 77, 36, 74, 76, 39] },
    { "type": "tm1638", "name": "TM1638", "base": "auto", "dio": 25, "clk": 26, "stb": 27 },
    { "type": "stim", "name": "STIM", "base": "auto", "width": 16, "out": null, "irq": "plic" },
    {
      "type": "uart",
      "name": "UART",
      "base": "auto",
      "tx": 17,
      "rx": 18,
      "baud": 115200,
      "parity": "none",
      "stop": 1,
      "fifo": 16,
      "irq": "plic"
    },
    {
      "type": "spiflash",
      "name": "SPIFLASH",
      "base": "auto",
      "sck": 59,
      "cs": 60,
      "mosi": 61,
      "miso": 62,
      "sizeMB": 4,
      "div": 1,
      "fpgaConfig": false,
      "bootAddr": "0x100000"
    },
    {
      "type": "sifu",
      "name": "SIFU",
      "base": "auto",
      "ab": 11,
      "ba": 10,
      "bc": 15,
      "cb": 14,
      "ca": 13,
      "ac": 16,
      "vs1": 69,
      "vs2": 29,
      "vs3": 57,
      "vs4": 68,
      "vs5": 30,
      "vs6": 56,
      "grid": 51,
      "sawHz": 500000,
      "delayTicks": 400,
      "pulseTicks": 150,
      "sim": true,
      "irq": "plic"
    }
  ],
  "ioDefaults": { "ioType": "LVCMOS18", "pull": "UP", "drive": "8", "vccio": "1.8" },
  "banks": {
    "0": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "1": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "2": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "3": { "ioType": "LVCMOS18", "vccio": "1.8" }
  },
  "pins": {
    "3": { "net": "RESET" },
    "10": { "net": "NSB_BA" },
    "11": { "net": "NSB_AB" },
    "13": { "net": "NSB_CA" },
    "14": { "net": "NSB_CB" },
    "15": { "net": "NSB_BC" },
    "16": { "net": "NSB_AC" },
    "17": { "net": "UART_TX" },
    "18": { "net": "UART_RX" },
    "25": { "net": "GPIO[0]" },
    "26": { "net": "GPIO[1]" },
    "27": { "net": "GPIO[2]" },
    "29": { "net": "VS2" },
    "30": { "net": "VS5" },
    "36": { "net": "DI3" },
    "39": { "net": "RO3" },
    "51": { "net": "GRID" },
    "52": { "net": "CLOCK" },
    "56": { "net": "VS6" },
    "57": { "net": "VS3" },
    "59": { "net": "FLASH_SCK" },
    "60": { "net": "FLASH_CS" },
    "61": { "net": "FLASH_MOSI" },
    "62": { "net": "FLASH_MISO" },
    "68": { "net": "VS4" },
    "69": { "net": "VS1" },
    "74": { "net": "RO1" },
    "75": { "net": "DI1" },
    "76": { "net": "RO2" },
    "77": { "net": "DI2" }
  },
  "build": { "toolchain": "gowin", "placeOption": "1", "loadingRate": "25.000" }
}
