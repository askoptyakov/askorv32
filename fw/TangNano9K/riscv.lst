__SIFU_INLINE void SIFU_ExtEnable(void)  { SIFU->CR |=  SIFU_CR_UEXT; }
__SIFU_INLINE void SIFU_ExtDisable(void) { SIFU->CR &= ~SIFU_CR_UEXT; }
