int32_t ADC121_ToMilli(ADC121_Cal cal, uint32_t code) {
	/* (код - смещение) в тысячных долях кода * мк-единиц на код / 1e6 = тысячные доли единицы */
	return (int32_t)((((int64_t)code * 1000 - cal.offset_m) * cal.scale_u) / 1000000);
}

