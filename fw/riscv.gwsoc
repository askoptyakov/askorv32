{
  "format": "askorv32-gwsoc",
  "version": 1,
  "device": "GW1NR-LV9QN88PC6/I5",
  "paths": { "hw": "../hw", "top": "src/top.sv", "cst": "src/riscv.cst", "generator": "../sw/socgen/socgen.py" },
  "core": {
    "coreType": "pipeline",
    "mExt": true,
    "divBpc": 2,
    "debug": true,
    "plicSources": 8,
    "imem": { "type": "bsram", "kb": 16, "synthWords": 256, "init": "mem_init/i.mem" },
    "dmem": { "type": "bsram", "kb": 8, "synthWords": 256, "init": "mem_init/d.mem" }
  },
  "clock": {
    "xtalMHz": 27,
    "xtalPin": 52,
    "pll": { "mode": "auto", "targetMHz": 45, "idiv": 2, "fbdiv": 4, "odiv": 16 }
  },
  "reset": { "pin": 3 },
  "blocks": {
    "gpio": {
      "enabled": true,
      "base": "auto",
      "lines": [10, 11, 13, 14, 15, 16]
    },
    "tm1638": { "enabled": true, "base": "auto", "dio": 25, "clk": 26, "stb": 27 },
    "stim": { "enabled": true, "base": "auto", "width": 16, "out": 68, "irq": "plic" },
    "uart": {
      "enabled": true,
      "base": "auto",
      "tx": 17,
      "rx": 18,
      "baud": 115200,
      "parity": "none",
      "stop": 1,
      "fifo": 16,
      "irq": "plic"
    }
  },
  "ioDefaults": { "ioType": "LVCMOS18", "pull": "UP", "drive": "8", "vccio": "1.8" },
  "banks": {
    "0": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "1": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "2": { "ioType": "LVCMOS33", "vccio": "3.3" },
    "3": { "ioType": "LVCMOS18", "vccio": "1.8" }
  },
  "pins": {
    "3": { "net": "rst_n" },
    "10": { "net": "led[0]" },
    "11": { "net": "led[1]" },
    "13": { "net": "led[2]" },
    "14": { "net": "led[3]" },
    "15": { "net": "led[4]" },
    "16": { "net": "led[5]" },
    "17": { "net": "uart_tx" },
    "18": { "net": "uart_rx" },
    "25": { "net": "GPIO[0]" },
    "26": { "net": "GPIO[1]" },
    "27": { "net": "GPIO[2]" },
    "52": { "net": "clk" },
    "68": { "net": "stim_out" }
  },
  "build": { "toolchain": "gowin" }
}
