{
  "format": "askorv32-gwsoc",
  "version": 1,
  "device": "GW1NR-LV9QN88PC6/I5",
  "paths": { "hw": "../hw", "top": "src/top.sv", "cst": "src/riscv.cst", "generator": "../sw/socgen/socgen.py" },
  "core": {
    "coreType": "pipeline",
    "mExt": true,
    "divBpc": 2,
    "imem": { "type": "bsram", "kb": 8, "synthWords": 256, "init": "mem_init/i.mem" },
    "dmem": { "type": "bsram", "kb": 8, "synthWords": 256, "init": "mem_init/d.mem" },
    "debug": true,
    "plicSources": 8
  },
  "clock": {
    "xtalMHz": 27,
    "xtalPin": 52,
    "pll": { "mode": "auto", "targetMHz": 45, "idiv": 2, "fbdiv": 4, "odiv": 16 }
  },
  "reset": { "pin": 3 },
  "blocks": {
    "gpio": {
      "enabled": true,
      "base": "auto",
      "lines": [10, 11, 13, 14, 15, 16, 75, 77, 36, 74, 76, 39, 56, 57]
    },
    "tm1638": { "enabled": false, "base": "auto", "dio": 25, "clk": 26, "stb": 27 },
    "stim": { "enabled": true, "base": "auto", "width": 16, "out": 68 }
  },
  "ioDefaults": { "ioType": "LVCMOS18", "pull": "UP", "drive": "8", "vccio": "1.8" },
  "pins": {
    "3": { "net": "rst_n" },
    "10": { "net": "led[0]" },
    "11": { "net": "led[1]" },
    "13": { "net": "led[2]" },
    "14": { "net": "led[3]" },
    "15": { "net": "led[4]" },
    "16": { "net": "led[5]" },
    "25": { "net": "GPIO[0]" },
    "26": { "net": "GPIO[1]" },
    "27": { "net": "GPIO[2]" },
    "36": { "net": "GMB_GPIO[2]" },
    "39": { "net": "GMB_GPIO[5]" },
    "52": { "net": "clk" },
    "56": { "net": "GMB_DRIVER_E[0]" },
    "57": { "net": "GMB_DRIVER_E[1]" },
    "68": { "net": "GMB_DRIVER_D[0]" },
    "69": { "net": "GMB_DRIVER_D[1]" },
    "74": { "net": "GMB_GPIO[3]" },
    "75": { "net": "GMB_GPIO[0]" },
    "76": { "net": "GMB_GPIO[4]" },
    "77": { "net": "GMB_GPIO[1]" }
  },
  "build": { "toolchain": "apicula" }
}
